// Terracotta Plymouth theme.
//
// Deliberately minimal: the mono logo centered on the brand's dark
// "kiln at night" background (palette.md `bg`, dark-context #17110D),
// plus a plain progress bar that fills in the brand accent
// (`terracotta`, dark-context #D9673C) as boot proceeds. No throbber
// or frame-sequence animation — everything here is a primitive the
// "script" splash module already provides, so the theme carries no
// extra runtime dependency.

Window.SetBackgroundTopColor(0.090, 0.067, 0.051);
Window.SetBackgroundBottomColor(0.090, 0.067, 0.051);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(screen_w / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(screen_h / 2 - logo.image.GetHeight() / 2 - screen_h * 0.05);

// Progress bar: two small solid-color swatches (progress-track.png,
// progress-fill.png) scaled up to the bar's on-screen size, rather than
// drawing rectangles procedurally — this is the same technique used by
// most stock Plymouth script themes.
bar.width = screen_w * 0.20;
bar.height = 3;
bar.x = screen_w / 2 - bar.width / 2;
bar.y = logo.sprite.GetY() + logo.image.GetHeight() + screen_h * 0.05;

track.image = Image("progress-track.png").Scale(bar.width, bar.height);
track.sprite = Sprite(track.image);
track.sprite.SetX(bar.x);
track.sprite.SetY(bar.y);

fill.base_image = Image("progress-fill.png");
fill.sprite = Sprite();
fill.sprite.SetX(bar.x);
fill.sprite.SetY(bar.y);

fun progress_callback(duration, progress)
{
    fill_width = Math.Int(bar.width * progress);
    if (fill_width < 1)
        fill_width = 1;
    fill.sprite.SetImage(fill.base_image.Scale(fill_width, bar.height));
}

Plymouth.SetBootProgressFunction(progress_callback);

// Password prompt (LUKS unlock, etc): plain text, no dialog chrome —
// same "logo + one line" minimalism as the rest of the theme.
fun display_password_callback(prompt, bullets)
{
    local.text = "";
    for (local.i = 0; local.i < bullets; local.i++)
        local.text += "*";
    if (prompt)
        local.text = prompt + " " + local.text;

    password.image = Image.Text(local.text, 0.910, 0.835, 0.753);
    if (!password.sprite)
        password.sprite = Sprite();
    password.sprite.SetImage(password.image);
    password.sprite.SetX(screen_w / 2 - password.image.GetWidth() / 2);
    password.sprite.SetY(bar.y + screen_h * 0.06);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
