// Terracotta Plymouth theme.
//
// Deliberately minimal: the mono logo centered on the brand's dark
// "kiln at night" background (palette.md `bg`, dark-context #17110D),
// with a spinner turning below it — a static ring in `surface-border`
// and an arc in the brand accent (`terracotta`, dark-context #D9673C)
// sweeping clockwise. The arc's frames are the pre-rendered
// spinner-NNNN.png images (see generate.sh); nothing here needs more
// than the stock "script" splash module already provides.

Window.SetBackgroundTopColor(0.090, 0.067, 0.051);
Window.SetBackgroundBottomColor(0.090, 0.067, 0.051);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(screen_w / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(screen_h / 2 - logo.image.GetHeight() / 2 - screen_h * 0.05);
logo.sprite.SetZ(0);

// Spinner geometry. Every spinner image is square and the same size, so a
// single center point places the static ring and each arc frame.
spinner.track_image = Image("spinner-track.png");

spinner.center_x = screen_w / 2;
spinner.center_y = logo.sprite.GetY() + logo.image.GetHeight() + screen_h * 0.05
                   + spinner.track_image.GetHeight() / 2;

spinner.track_sprite = Sprite(spinner.track_image);
spinner.track_sprite.SetX(spinner.center_x - spinner.track_image.GetWidth() / 2);
spinner.track_sprite.SetY(spinner.center_y - spinner.track_image.GetHeight() / 2);
spinner.track_sprite.SetZ(1);

// Arc frames, one per 10° step. Must match SPINNER_FRAMES in generate.sh.
spinner.frame_count = 36;
// Refreshes to hold each frame. Plymouth's default refresh rate is 50Hz,
// so 3 gives 36 * 3 / 50 ≈ 2.2s per revolution.
spinner.frame_hold = 3;

for (i = 0; i < spinner.frame_count; i++)
{
    // Image() takes no format string, so pad the index to four digits by hand.
    frame_name = "000" + i;
    if (i >= 10)
        frame_name = "00" + i;
    spinner.frames[i] = Image("spinner-" + frame_name + ".png");
}

spinner.sprite = Sprite();
spinner.sprite.SetZ(2);
spinner.tick = 0;

fun show_spinner_frame(index)
{
    local.image = spinner.frames[index];
    spinner.sprite.SetImage(local.image);
    spinner.sprite.SetX(spinner.center_x - local.image.GetWidth() / 2);
    spinner.sprite.SetY(spinner.center_y - local.image.GetHeight() / 2);
}

show_spinner_frame(0);

fun refresh_callback()
{
    spinner.tick++;
    if (spinner.tick >= spinner.frame_count * spinner.frame_hold)
        spinner.tick = 0;
    show_spinner_frame(Math.Int(spinner.tick / spinner.frame_hold));
}

Plymouth.SetRefreshFunction(refresh_callback);

// Password prompt (LUKS unlock, etc): a static field outline, visible the
// moment Plymouth asks — not just once typing starts, which otherwise
// looks identical to the spinner just still loading — with one dot per
// typed character filling in left-to-right inside it. No dialog chrome
// beyond that outline, same "logo + one line" minimalism as the rest of
// the theme. Deliberately not Image.Text: it needs a font, and dracut only
// bundles one into the initramfs if fc-match finds one installed —
// @kiln/profiles/minimal ships none, which left this prompt silently
// invisible (logo and spinner still rendered fine, being plain PNGs with
// no font dependency). password-dot.png/password-box.png sidestep that
// the same way the spinner frames sidestep Image.Rotate's
// nearest-neighbour artifacts.
password.dot_image = Image("password-dot.png");
password.dot_gap = password.dot_image.GetWidth() * 1.8;
password.box_image = Image("password-box.png");
password.box_pad = 14; // must match BOX_PAD in generate.sh

password.box_x = screen_w / 2 - password.box_image.GetWidth() / 2;
password.box_y = spinner.center_y + spinner.track_image.GetHeight() / 2 + screen_h * 0.04;
password.row_x = password.box_x + password.box_pad;
password.row_y = password.box_y + (password.box_image.GetHeight() - password.dot_image.GetHeight()) / 2;

password.box_sprite = Sprite(password.box_image);
password.box_sprite.SetX(password.box_x);
password.box_sprite.SetY(password.box_y);
password.box_sprite.SetZ(3);
password.box_sprite.SetOpacity(0);

password.dot_count = 0;

fun display_password_callback(prompt, bullets)
{
    password.box_sprite.SetOpacity(1);

    local.max = bullets;
    if (password.dot_count > local.max)
        local.max = password.dot_count;

    for (local.i = 0; local.i < local.max; local.i++)
    {
        if (!password.dots[local.i])
        {
            password.dots[local.i] = Sprite(password.dot_image);
            password.dots[local.i].SetX(password.row_x + local.i * password.dot_gap);
            password.dots[local.i].SetY(password.row_y);
            password.dots[local.i].SetZ(4);
        }

        if (local.i < bullets)
            password.dots[local.i].SetOpacity(1);
        else
            password.dots[local.i].SetOpacity(0);
    }

    password.dot_count = bullets;
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);

// Fires once the prompt is answered (or cancelled), so the field doesn't
// linger on screen after boot moves past it.
fun display_normal_callback()
{
    password.box_sprite.SetOpacity(0);
    for (local.i = 0; local.i < password.dot_count; local.i++)
        password.dots[local.i].SetOpacity(0);
    password.dot_count = 0;
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
